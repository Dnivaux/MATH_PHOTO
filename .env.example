# Copier en .env
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=mathapp-weekend
# Infra (docker compose)
POSTGRES_PASSWORD=mlflow
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret-123
# Serveur
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=teacher-ft
HF_HOME=/home/dnivaux/.cache/huggingface
# Le téléchargement multipart via le proxy MLflow bloque (requêtes Range) : on le coupe.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
GATEWAY_TOKENS=dev-token
# Administration de la gateway (/admin : utilisateurs, clés, usage). Vide = /admin fermé.
GATEWAY_ADMIN_TOKEN=
# Modèle d'explication (registry MLflow, alias champion) : téléphones, ordinateur et mode léger
EXPLAINER_REGISTRY=explainer-0.6b-p20-gguf
# Canary du modèle de code : part du trafic de /v1/solve au démarrage, puis PUT /admin/canary (0 = retour arrière)
CANARY_REGISTRY=math-1.5b-distill
CANARY_WEIGHT=0.1
# Part de la mémoire GPU de chaque vLLM (champion, canary)
GPU_UTIL=0.60
CANARY_GPU_UTIL=0.20
# Secret partagé gateway ↔ bac à sable (conteneur sans réseau extérieur)
SANDBOX_TOKEN=change-me
# Grafana (http://localhost:3000, utilisateur admin)
GRAFANA_ADMIN_PASSWORD=admin

# Développement seulement : la gateway garde les photos relues par l'OCR serveur et sa lecture
# (récupération : docker compose cp gateway:/cache/ocr-captures .). Jamais en production : photos d'élèves.
# GATEWAY_OCR_CAPTURE_DIR=/cache/ocr-captures
